# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/chathub

# ─── Auth (JWT) ───────────────────────────────────────────
# Generate strong secrets, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Cookie domain settings. In production (Vercel <-> Render are cross-site)
# COOKIE_SECURE must be true and COOKIE_SAMESITE must be "none".
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ─── Uploads (Cloudinary, optional) ───────────────────────
# If unset, file/image sharing endpoints return 501 Not Implemented.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
