# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/chathub

# ─── Auth (JWT) ───────────────────────────────────────────
# Generate strong secrets, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Cookie domain settings. In production (Vercel <-> Render are cross-site)
# COOKIE_SECURE must be true and COOKIE_SAMESITE must be "none".
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ─── Uploads (Cloudinary, optional) ───────────────────────
# If unset, file/image sharing endpoints return 501 Not Implemented.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Calls (WebRTC, optional TURN) ────────────────────────
# STUN is free/public and always used. TURN is only needed for the ~15-20% of
# networks that can't connect peer-to-peer; leave blank for STUN-only (Phase 1).
# To enable a relay, run coturn with `use-auth-secret` and set the same secret.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_SECRET=
TURN_TTL_SECONDS=3600
